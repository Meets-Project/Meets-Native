# Backend - Variáveis de Ambiente para Docker

# Firebase/Firestore
FIREBASE_PROJECT_ID=snack-local
FIRESTORE_EMULATOR_HOST=firestore-emulator:8080

# Servidor
PORT=3000
NODE_ENV=production

# CORS - permitir frontend no Docker
CORS_ORIGIN=http://frontend:8081

# Para Firestore Real (descomentar em produção)
# FIREBASE_SERVICE_ACCOUNT_BASE64=<sua_chave_base64_aqui>
