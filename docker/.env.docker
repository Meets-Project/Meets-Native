# Configuração para Docker
# Para Firestore Emulator (desenvolvimento)
FIREBASE_PROJECT_ID=snack-local
FIRESTORE_EMULATOR_HOST=firestore-emulator:8080

# Para Firestore Real (produção) - descomentar e configurar
# FIREBASE_SERVICE_ACCOUNT_BASE64=<sua_chave_base64_aqui>

# API URLs internas (comunicação Docker)
BACKEND_URL=http://backend:3000
FRONTEND_URL=http://frontend:8081

# Node Environment
NODE_ENV=production
