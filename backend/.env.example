PORT=3333
DATABASE_URL=postgresql://meets:meets@localhost:5432/meets
JWT_SECRET=change-this-in-production

# CORS_ORIGIN: use * to allow all origins (development / Render free tier),
# or set a comma-separated list of allowed frontend URLs for production.
# Examples:
#   CORS_ORIGIN=*
#   CORS_ORIGIN=https://meets-native.onrender.com,https://meets-native.vercel.app
# WARNING: do NOT set this to a random hash/secret — it will block all browsers.
CORS_ORIGIN=*

# E-mail verification (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
SMTP_FROM=Meets <seu-email@gmail.com>
EMAIL_VERIFICATION_MINUTES=30
